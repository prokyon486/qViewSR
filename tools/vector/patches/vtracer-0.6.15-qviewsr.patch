 fn patch_good(
+    internal: &BuilderImpl,
+    patch: &Cluster,
+    good_min_area: usize,
+    good_max_area: usize,
+) -> bool {
+    let result = patch_good_sparse(internal, patch, good_min_area, good_max_area);
+    #[cfg(test)]
+    {
+        assert_eq!(result, patch_good_raster(internal, patch, good_min_area, good_max_area),
+            "patch_good changed: area={}, holes={}, merged_into={}",
+            patch.area(), patch.holes.len(), patch.merged_into.0);
+        PATCH_GOOD_COMPARISONS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
+    result
+}
+
+fn patch_good_sparse(
+    internal: &BuilderImpl,
+    patch: &Cluster,
+    good_min_area: usize,
+    good_max_area: usize,
+) -> bool {
+    if !(good_min_area < patch.area() && patch.area() < good_max_area) {
+        return false;
+    }
+    if good_min_area == 0 {
+        return true;
+    }
+    let owner = internal.cluster_indices[patch.indices[0] as usize];
+    // ZERO also labels discarded key pixels that need not belong to its indices.
+    // Deepened snapshots no longer own their pixels. Keep the old definition
+    // for both, and for any caller passing a separate clone of a cluster.
+    if owner == super::builder::ZERO || patch.merged_into != super::builder::ZERO ||
+        !std::ptr::eq(patch, internal.get_cluster(owner)) {
+        #[cfg(test)] PATCH_GOOD_FALLBACK.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        return patch_good_raster(internal, patch, good_min_area, good_max_area);
+    }
+    // Active holes were appended only after these pixels were merged into the
+    // target indices. Removing at least one pixel gives boundary < full area.
+    if !patch.holes.is_empty() {
+        #[cfg(test)] PATCH_GOOD_HOLES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        return true;
+    }
+    let width = internal.width as usize;
+    let owners = &internal.cluster_indices;
+    for &pixel in &patch.indices {
+        let pixel = pixel as usize;
+        let x = pixel % width;
+        if x > 0 && x + 1 < width && pixel >= width && pixel + width < owners.len() &&
+            owners[pixel - 1] == owner && owners[pixel + 1] == owner &&
+            owners[pixel - width] == owner && owners[pixel + width] == owner {
+            #[cfg(test)] PATCH_GOOD_INTERIOR.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            return true;
+        }
+    }
+    #[cfg(test)] PATCH_GOOD_THIN.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    false
+}
